rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCreator() {
      return signedIn() && request.auth.token.email == 'dheerajsinghbaghel1306@gmail.com';
    }

    function isAdmin() {
      return isCreator() || (signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'));
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['tournamentId', 'teamName', 'leaderEmail', 'leaderPhone', 'players', 'status']) &&
             data.status == 'pending' &&
             data.players is list && data.players.size() == 4 &&
             data.teamName is string && data.teamName.size() >= 2 && data.teamName.size() <= 60 &&
             data.leaderEmail is string && data.leaderEmail.size() <= 100 &&
             data.leaderPhone is string && data.leaderPhone.size() >= 10 && data.leaderPhone.size() <= 20;
    }

    // ===============================================================
    // 1. PUBLIC READ ACCESS (Only for safe collections)
    // ===============================================================
    match /tournaments/{tid}/{document=**} {
      allow read: if true; // Public can read matches and teams
    }
    
    match /config/{doc} {
      allow read: if true;
      allow write: if isCreator() || isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isCreator() || isAdmin();
    }

    match /publicAnalytics/{tid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // 2. TOURNAMENTS
    // ===============================================================
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();
     
      match /matches/{mid} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /otrClaims/{otr} { 
        allow create: if true; 
        allow update, delete: if isAdmin(); 
      }
    }

    // ===============================================================
    // 3. REGISTRATIONS (Public Create, Admin Manage)
    // ===============================================================
    match /registrations/{rid} {
      allow create: if isValidRegistration(request.resource.data);
      allow read, update, delete: if isAdmin(); // Only admins can see team details
    }

    // ===============================================================
    // 4. PRIVATE SECRETS (Strictly Admin/Creator)
    // ===============================================================
    match /matchSecrets/{mid} {
      allow read, write: if isAdmin(); // Passwords are hidden from public
    }

    match /adminRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if isCreator() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isCreator();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if (signedIn() && request.auth.uid == uid) || isCreator();
    }

    match /contactMessages/{id} {
      allow create: if true;
      allow read, write: if isCreator();
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}