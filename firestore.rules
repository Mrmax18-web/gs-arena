rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    
    // Hardcoded creator/admin email because we are NOT using Cloud Functions
    function isCreator() {
      return signedIn() && request.auth.token.email == 'dheerajsinghbaghel1306@gmail.com';
    }
    
    function isAdmin()   { 
      return isCreator(); 
    }
    
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 1. Config & Games (Public read, Creator write)
    match /config/{doc} {
      allow read: if true;
      allow write: if isCreator();            
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isCreator();
    }

    // 2. Tournaments (Public read, Admin write)
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();
      match /matches/{mid} { allow read: if true; allow write: if isAdmin(); }
      match /teams/{teamId} { allow read: if true; allow write: if isAdmin(); }
      match /otrClaims/{otr} {
        allow read: if isAdmin() || signedIn();
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /publicAnalytics/{tid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matchSecrets/{mid} {
      allow read, write: if isAdmin();         
    }

    // 3. Registrations (PUBLIC CAN REGISTER, Admin can manage)
    match /registrations/{rid} {
      allow create: if true;           // <--- CRITICAL: Allows anyone to register
      allow read: if isAdmin();        // Only admins can see the list
      allow update: if isAdmin();      // Only admins can approve/reject
      allow delete: if isAdmin();
    }

    // 4. Admin Requests (Public can apply, Creator can approve)
    match /adminRequests/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if isCreator() || (signedIn() && request.auth.uid == uid);
      allow update: if isCreator();    // <--- CRITICAL: Allows Creator to click Approve
      allow delete: if isCreator();
    }

    // 5. Users (Only the user can read/write their own data)
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // 6. Contact Messages (Public can send, Creator can read)
    match /contactMessages/{id} {
      allow create: if true;
      allow read: if isCreator();
      allow update, delete: if false;
    }

    // 7. Deny all other access by default
    match /{document=**} { allow read, write: if false; }
  }
}