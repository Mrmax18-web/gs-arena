rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN & CREATOR CHECK
    function isCreator() {
      return request.auth != null && (
        request.auth.token.email in [
          'dheerajsinghbaghel65@gmail.com',
          'dheerajsinghbaghel1306@gmail.com',
          'gsarena704@gmail.com'
        ] || (
          exists(/databases/$(database)/documents/config/creator) &&
          request.auth.token.email == get(/databases/$(database)/documents/config/creator).data.creatorEmail
        )
      );
    }

    function isAdmin() {
      return isCreator();
    }

    // Background configuration: readable by all, writable only by creator emails
    match /config/background {
      allow read: if true;
      allow write: if isCreator();
    }

    // User preferences (e.g. theme preference): readable/writable only by that user uid
    match /users/{userId}/prefs/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create, update, delete: if true;
      
      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    match /registrations/{rid} {
      allow create, read, update, delete: if true;
    }

    match /adminRequests/{rid} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isCreator();
    }

    match /audit/{aid} {
      allow create, read, update, delete: if true;
    }

    match /test-ping/{tid} {
      allow read, write: if true;
    }
  }
}
