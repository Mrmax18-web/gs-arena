# Frontend Firebase Web Configuration (Vite)
# Replace with your Firebase Project Configuration values from Firebase Console -> Project Settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase Storage Configuration (Required for GS Arena logos and payment receipts)
# Replace with your project URL and public anon key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Set to 'true' to connect to local Firebase Emulators in development
VITE_USE_FIREBASE_EMULATORS=false
